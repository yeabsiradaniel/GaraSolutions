# Served from cPanel/Apache. Vite copies this into dist/ on every build.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Asset filenames carry a content hash, so they can be cached indefinitely.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # index.html must always be revalidated, or new deploys never reach anyone.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS. Safe only because a valid certificate is already issued;
  # enabling this without one makes every browser show a hard security error.
  # The second condition keeps shared hosts that terminate TLS at a proxy
  # from looping, since %{HTTPS} reads as off behind one.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# No SPA fallback rewrite here on purpose: this site is one page with anchor
# links, not a client-side router, so there is no path for the server to hand
# back. Rewriting unknown paths to index.html would answer them 200 OK and let
# search engines index unlimited soft-404 duplicates of the homepage.
#
# ErrorDocument still shows visitors the site rather than a bare Apache error,
# but Apache keeps the 404 status, which is what crawlers read.
ErrorDocument 404 /index.html
